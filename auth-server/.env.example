# AuthPro account
AUTHPRO_USER=Jergan
AUTHPRO_API_KEY=PUT_YOUR_AUTHPRO_API_KEY_HERE

# Generate a long random secret. Do not commit the real value.
JWT_SECRET=PUT_A_LONG_RANDOM_SECRET_HERE

# Comma-separated app origins allowed to call this API.
# Example:
# ALLOWED_ORIGINS=https://your-site.vercel.app,https://your-app.example.com
ALLOWED_ORIGINS=

PORT=3000
